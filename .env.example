# Copy to .env.local (dev) and set the same names in Vercel → Settings → Environment Variables (Production).
# NEXT_PUBLIC_* values are baked in at build time: redeploy after changing them.
# Never commit real values.

# ── Clerk (auth) — dev: pk_test/sk_test · live: production instance pk_live/sk_live ──
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# ── Razorpay — dev: rzp_test_ · live: rzp_live_ (the key id is sent to the browser at runtime) ──
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
# Dashboard → Webhooks (separate for test and live mode): https://<domain>/api/webhooks/razorpay
# Events: payment.captured, order.paid
RAZORPAY_WEBHOOK_SECRET=

# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Resend (email) — verify the domain's DNS in Resend; FROM needs no real mailbox ──
RESEND_API_KEY=re_...
STORE_EMAIL=orders@zevarbaksa.com     # FROM address
ADMIN_EMAIL=                          # gets every paid order — any inbox you read
CONTACT_EMAIL=                        # gets contact-form enquiries

# ── Public contact details (contact + policy pages; Razorpay review checks these) ──
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_WHATSAPP_NUMBER=          # digits with country code, e.g. 919876543210
NEXT_PUBLIC_GRIEVANCE_OFFICER_NAME=
NEXT_PUBLIC_GRIEVANCE_OFFICER_DESIGNATION=Grievance Officer
NEXT_PUBLIC_GRIEVANCE_OFFICER_EMAIL=

# ── Site ──
NEXT_PUBLIC_SITE_URL=https://zevarbaksa.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Secrets for internal routes (openssl rand -hex 32) ──
ADMIN_API_SECRET=                     # x-admin-secret header for /api/orders, /api/admin/order-update
CRON_SECRET=                          # Vercel Cron → /api/cron/expire-pending-orders

# ── BUSY accounting (NeoInfotech API V2) ──
BUSY_API_URL=https://neoinfotech.in/api/v2
BUSY_COMPANY_CODE=
BUSY_API_KEY=
BUSY_USER=
BUSY_PASSWORD=
BUSY_DEFAULT_PARTY_CODE=1290
BUSY_SETTLEMENT_PARTY_CODE=1
BUSY_WEBHOOK_SECRET=

# ── Tax invoices (/api/admin/order-update action "invoice") — blank GSTIN disables invoices ──
BUSINESS_GSTIN=
BUSINESS_LEGAL_NAME=
BUSINESS_STATE=
BUSINESS_HSN=
BUSINESS_ADDRESS=
